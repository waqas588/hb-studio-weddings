# ------------------------------------------------------------------
# HB Studio Weddings — environment variables
# Copy this file to .env.local for local development and fill in real
# values in your hosting provider's dashboard (Vercel/Netlify) for
# production. Never commit .env.local or any file with real secrets.
# ------------------------------------------------------------------

# Public site URL, used for canonical links, sitemap and Open Graph.
# Safe to expose (NEXT_PUBLIC_*) because it is just the site's own address.
NEXT_PUBLIC_SITE_URL=https://www.hbstudioweddings.com

# Public-facing contact details shown in the footer, contact page and
# WhatsApp buttons. These are intentionally NEXT_PUBLIC_* because they
# are meant to be visible to visitors. Replace with the client's real
# details before launch — do not commit real numbers to a public repo
# owned by someone else.
NEXT_PUBLIC_CONTACT_EMAIL=handsomhabib@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+92 300 0000000
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/hbstudioweddings
NEXT_PUBLIC_FACEBOOK_URL=

# ------------------------------------------------------------------
# Server-only email delivery settings. Never prefix these with
# NEXT_PUBLIC_ and never commit the API key.
# ------------------------------------------------------------------
# RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=handsomhabib@gmail.com

# Optional: token for a rate-limiting / spam-protection provider
# (e.g. Upstash Redis) if you upgrade beyond the in-memory limiter.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
